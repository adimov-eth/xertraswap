{
  "name": "xertra",
  "private": true,
  "workspaces": [
    "packages/*",
    "interface"
  ],
  "scripts": {
    "build:sdk": "yarn workspace @xertra/sdk build",
    "build:interface": "yarn workspace @xertra/interface build",
    "dev": "yarn build:sdk && yarn workspace @xertra/interface start",
    "build": "yarn build:sdk && yarn build:interface",
    "typecheck": "yarn workspace @xertra/interface typecheck",
    "lint": "yarn workspace @xertra/interface lint",
    "test": "yarn workspace @xertra/interface test"
  },
  "resolutions": {
    "eslint-plugin-react": "7.37.5",
    "typescript": "~5.9.0"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "cross-env": "^10.1.0"
  }
}
